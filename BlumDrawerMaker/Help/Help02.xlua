function HTMLHelp02()
    DialogWindow.Help02 = [[<!DOCTYPE html><html lang="en"><head><title>Help</title></head> ]] .. Style00() .. [[
  <body><div class="layout">
    <div class="h3-lP">
      <label>Project Setup Menu Help</label>
    </div>
    <div>
      <div class="helpProjectimage"><img src="]] .. Project.AppPath ..
                              [[/Help/Images/Project_Menu.png" width="500"></div>
      <div class="h2-lP">
        <label>Project Setup</label>
      </div>
      <div class="h1-help">
        <p>Use the Project Setup menu to enter the project data and the folder for the files. All fields are
        necessary.</p>
        <ul>
          <li class="h1-help"><strong>Project Name - </strong>The name of the project.</li>
          <li class="h1-help"><strong>Contact Name - </strong>The name of the contact person.</li>
          <li class="h1-help"><strong>Contact Email - </strong>The email address of the contact person.</li>
          <li class="h1-help"><strong>Phone Number - </strong>The phone number of the contact person.</li>
          <li class="h1-help"><strong>Drawer ID - </strong>The gadget makes this ID from the date and a job number. You
              cannot change it.</li>
          <li class="h1-help"><strong>Project Path - </strong>The folder for the files that the gadget makes. Click
              <strong>Path</strong> to select the folder. The gadget saves the cut list (.html, .dat and .csv) and the
              export file of your settings (.lua) in this folder.</li>
        </ul>
      </div>
    </div>
    <div><hr /></div>
      <span class="helpimagesFooter"><img src="]] .. Project.AppPath ..
                              [[/Help/Images/Footer.png" width="80" height="20" alt="Page Footer"></span>
      </div>
      <div class="foot" id="FooterBox">
    <div><hr /></div>
      <div align="center">
        <input id="ButtonOK" class="FormButton" name="ButtonOK" type="button" value="Close"  />
      </div>
    </div>
  </div>
</body>
</html>]]
    return true
end -- Function End
--  ================================================================]]
function Style00()
    return [[<style>
	.FormButton {
		font-family: Arial, Helvetica, sans-serif;
		font-weight: bold;
		font-size: 12px;
		white-space: nowrap;
		background-color: #663300;
		color: #FFFFFF;
	}
  .h1-help {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 14px;
    text-align: left;
    padding-right: 4px;
    padding-left: 4px;
  }
  .h2-lP {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 16px;
    font-weight: bold;
    text-align: left;
    padding-top: 4px;
    padding-right: 8px;
    padding-left: 18px;
  }
  .h2-lP {
		font-family: Arial, Helvetica, sans-serif;
		font-size: 16px;
		font-weight: bold;
		text-align: left;
		padding-top: 8px;
		padding-right: 8px;
		padding-left: 8px;
	}
  .h3-lP {
		font-family: Arial, Helvetica, sans-serif;
		font-size: 20px;
		font-weight: bold;
		text-align: left;
    width: 650px;
		padding-top: 18px;
		padding-right: 8px;
		padding-left: 8px;
	}
	.layout {
		background-color: white;
		color: #000000;
		overflow: auto;
		width: 99.5%;
    height: 44em;
	}
	.pad-10 {
    padding-bottom: 2em;
	}
	.foot {
		position: absolute;
		bottom: 1em;
		width: 62em;
	}
	.helpTopimage {
    position: static;
		width: 550px;
    height: 40em;
		margin: 10px 10px 10px 120px;
	}
  .helpAboutimage {
    position: static;
		width: 550px;
    height: 45em;
		margin: 10px 10px 10px 120px;
	}
  .helpProjectimage {
    position: static;
		width: 550px;
    height: 20em;
		margin: 10px 10px 10px 120px;
	}
	.helpimages {
    top: 10px;
    float: right;
		margin: 10px 10px 10px 10px;
	}
	.helpimagesX {
    top: 10px;
    float: right;
		margin: 10px 120px 10px 120px;
	}
  .helpimagesFooter {
    float: right;
    margin: 10px 313px 1px 10px;
  }
	body {
		background-color: #3a4660;
		background-position: center;
		overflow: hidden;
		font-family: arial, helvetica, sans-serif;
		font-size: 12px;
		color: #FFFFFF;
	 background-image: url(]] .. DialogWindow.myBackGround .. [[);
	}
	html {
		overflow: hidden
	}
</style>]]
end

