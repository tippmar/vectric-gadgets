-- VECTRIC LUA SCRIPT
-- =====================================================]]
-- Box Joint Runs is a separate gadget from Blum Drawer Maker: it shares no code and no
-- registry settings with it. Its own settings live under the "BoxJointRuns" section,
-- one row per unit system, exactly as BlumDrawerRegistry.xlua keeps Blum's.
-- =====================================================]]
local IMPERIAL_DEFAULTS = {
    StockT = 0.7500,
    StockW = 6.0000,
    FingerAuto = true,
    FingerCountManual = 5,
    JointStyle = "Through",
    FingerClearance = 0.0050,
    GrooveOn = true,
    GrooveInset = 0.5000,
    BottomThickness = 0.2500,
    GrooveClearance = 0.0120,
    GrooveDepth = 0.2500,
    FingerAllowance = 0.0000,
    GrooveAllowance = 0.0000,
    ProfileFinishAllowance = 0.0000,
    PartGap = 0.7500,
    ProfileTabs = true,
    ProfileFinish = false,
    Piece1Length = 12.0000,
    Piece2Length = 12.0000,
    Piece3Length = 12.0000,
    Piece4Length = 12.0000,
    Piece2Enabled = false,
    Piece3Enabled = false,
    Piece4Enabled = false,
    GrooveSide = "Inside",
    StartEnd = "None",
    EndEnd = "None",
    CloseLoop = false,
    EEToward = true,
    EEPhase = "Finger",
    EBBackLength = 24.0000,
    EBFirstStub = 9.0000,
    EBOpening = 6.0000,
    EBPhase = "Finger",
    Mode = "Test Cut"
}
local METRIC_DEFAULTS = {
    StockT = 19.0000,
    StockW = 150.0000,
    FingerAuto = true,
    FingerCountManual = 5,
    JointStyle = "Through",
    FingerClearance = 0.1270,
    GrooveOn = true,
    GrooveInset = 12.7000,
    BottomThickness = 6.3500,
    GrooveClearance = 0.3048,
    GrooveDepth = 6.3500,
    FingerAllowance = 0.0000,
    GrooveAllowance = 0.0000,
    ProfileFinishAllowance = 0.0000,
    PartGap = 19.0500,
    ProfileTabs = true,
    ProfileFinish = false,
    Piece1Length = 300.0000,
    Piece2Length = 300.0000,
    Piece3Length = 300.0000,
    Piece4Length = 300.0000,
    Piece2Enabled = false,
    Piece3Enabled = false,
    Piece4Enabled = false,
    GrooveSide = "Inside",
    StartEnd = "None",
    EndEnd = "None",
    CloseLoop = false,
    EEToward = true,
    EEPhase = "Finger",
    EBBackLength = 600.0000,
    EBFirstStub = 225.0000,
    EBOpening = 150.0000,
    EBPhase = "Finger",
    Mode = "Test Cut"
}
local TOOL_SLOTS = {
    {Slot = "Profile", Field = "ProfileTool"},
    {Slot = "Finger", Field = "FingerTool"},
    {Slot = "FingerClear", Field = "FingerClearTool"},
    {Slot = "Dado", Field = "DadoTool"}
}
-- =====================================================]]
function SettingDefaults()
    if Run.InMM then
        return METRIC_DEFAULTS
    end
    return IMPERIAL_DEFAULTS
end
-- =====================================================]]
function SettingsKey(name)
    if Run.InMM then
        return "Metric." .. name
    end
    return "Imperial." .. name
end
-- =====================================================]]
function ToolsRead()
    -- The four chosen tools, restored as plain tables carrying only the fields the toolpath calls read
    -- (modeled on HoldDownHelper's ToolRead/ToolWrite, Hold_Down_Helper.lua:225-266). A stored Name of ""
    -- means the slot was never chosen; ValidateSettings checks these fields for nil, so leave them nil.
    local registry = Registry(Run.RegName)
    for _, slot in ipairs(TOOL_SLOTS) do
        local prefix = slot.Slot .. "Tool."
        local name = registry:GetString(SettingsKey(prefix .. "Name"), "")
        if name == "" then
            Milling[slot.Field] = nil
        else
            Milling[slot.Field] = {
                Name = name,
                InMM = registry:GetBool(SettingsKey(prefix .. "InMM"), Run.InMM),
                ToolDia = registry:GetDouble(SettingsKey(prefix .. "ToolDia"), 0.0),
                Stepdown = registry:GetDouble(SettingsKey(prefix .. "Stepdown"), 0.0),
                Stepover = registry:GetDouble(SettingsKey(prefix .. "Stepover"), 0.0),
                RateUnits = registry:GetInt(SettingsKey(prefix .. "RateUnits"), 4),
                FeedRate = registry:GetDouble(SettingsKey(prefix .. "FeedRate"), 0.0),
                PlungeRate = registry:GetDouble(SettingsKey(prefix .. "PlungeRate"), 0.0),
                SpindleSpeed = registry:GetInt(SettingsKey(prefix .. "SpindleSpeed"), 18000),
                ToolNumber = registry:GetInt(SettingsKey(prefix .. "ToolNumber"), 1)
            }
        end
    end
end
-- =====================================================]]
function ToolsWrite()
    -- Reads each tool's fields once into the registry; the Vectric tool object itself is never stored.
    local registry = Registry(Run.RegName)
    for _, slot in ipairs(TOOL_SLOTS) do
        local prefix = slot.Slot .. "Tool."
        local tool = Milling[slot.Field]
        if tool == nil then
            registry:SetString(SettingsKey(prefix .. "Name"), "")
        else
            registry:SetString(SettingsKey(prefix .. "Name"), tool.Name)
            registry:SetBool(SettingsKey(prefix .. "InMM"), tool.InMM)
            registry:SetDouble(SettingsKey(prefix .. "ToolDia"), tool.ToolDia)
            registry:SetDouble(SettingsKey(prefix .. "Stepdown"), tool.Stepdown)
            registry:SetDouble(SettingsKey(prefix .. "Stepover"), tool.Stepover)
            registry:SetInt(SettingsKey(prefix .. "RateUnits"), tool.RateUnits)
            registry:SetDouble(SettingsKey(prefix .. "FeedRate"), tool.FeedRate)
            registry:SetDouble(SettingsKey(prefix .. "PlungeRate"), tool.PlungeRate)
            registry:SetInt(SettingsKey(prefix .. "SpindleSpeed"), tool.SpindleSpeed)
            registry:SetInt(SettingsKey(prefix .. "ToolNumber"), tool.ToolNumber)
        end
    end
end
-- =====================================================]]
function SettingsRead()
    local registry = Registry(Run.RegName)
    local defaults = SettingDefaults()
    Run.DialogWidth = registry:GetInt("DialogWidth", 620)
    Run.DialogHeight = registry:GetInt("DialogHeight", 880)
    Run.StockT = registry:GetDouble(SettingsKey("StockT"), defaults.StockT)
    Run.StockW = registry:GetDouble(SettingsKey("StockW"), defaults.StockW)
    Run.FingerAuto = registry:GetBool(SettingsKey("FingerAuto"), defaults.FingerAuto)
    Run.FingerCountManual = registry:GetInt(SettingsKey("FingerCountManual"), defaults.FingerCountManual)
    Run.JointStyle = registry:GetString(SettingsKey("JointStyle"), defaults.JointStyle)
    Run.FingerClearance = registry:GetDouble(SettingsKey("FingerClearance"), defaults.FingerClearance)
    Run.GrooveOn = registry:GetBool(SettingsKey("GrooveOn"), defaults.GrooveOn)
    Run.GrooveInset = registry:GetDouble(SettingsKey("GrooveInset"), defaults.GrooveInset)
    -- BottomThickness is a new key, not a rename of GrooveWidth: a saved groove width already has the
    -- clearance in it, and reading it as a thickness would add the clearance twice.
    Run.BottomThickness = registry:GetDouble(SettingsKey("BottomThickness"), defaults.BottomThickness)
    Run.GrooveClearance = registry:GetDouble(SettingsKey("GrooveClearance"), defaults.GrooveClearance)
    Run.GrooveDepth = registry:GetDouble(SettingsKey("GrooveDepth"), defaults.GrooveDepth)
    Run.Mode = registry:GetString(SettingsKey("Mode"), defaults.Mode)
    if Run.Mode ~= "Test Cut" and Run.Mode ~= "Chain" and Run.Mode ~= "Existing End" and Run.Mode ~= "Existing Back" then
        Run.Mode = defaults.Mode -- a blank or unknown value would leave the dropdown unselected
    end
    Run.EEToward = registry:GetBool(SettingsKey("EEToward"), defaults.EEToward)
    Run.EEPhase = registry:GetString(SettingsKey("EEPhase"), defaults.EEPhase)
    if Run.EEPhase ~= "Finger" and Run.EEPhase ~= "Gap" then
        Run.EEPhase = defaults.EEPhase
    end
    Run.EBBackLength = registry:GetDouble(SettingsKey("EBBackLength"), defaults.EBBackLength)
    Run.EBFirstStub = registry:GetDouble(SettingsKey("EBFirstStub"), defaults.EBFirstStub)
    Run.EBOpening = registry:GetDouble(SettingsKey("EBOpening"), defaults.EBOpening)
    Run.EBPhase = registry:GetString(SettingsKey("EBPhase"), defaults.EBPhase)
    if Run.EBPhase ~= "Finger" and Run.EBPhase ~= "Gap" then
        Run.EBPhase = defaults.EBPhase
    end
    Run.Piece = {}
    Run.Piece[1] = {Enabled = true, Length = registry:GetDouble(SettingsKey("Piece1Length"), defaults.Piece1Length)}
    for i = 2, 4 do
        Run.Piece[i] = {
            Enabled = registry:GetBool(SettingsKey("Piece" .. i .. "Enabled"), defaults["Piece" .. i .. "Enabled"]),
            Length = registry:GetDouble(SettingsKey("Piece" .. i .. "Length"), defaults["Piece" .. i .. "Length"])
        }
    end
    Run.GrooveSide = registry:GetString(SettingsKey("GrooveSide"), defaults.GrooveSide)
    if Run.GrooveSide ~= "Inside" and Run.GrooveSide ~= "Outside" then
        Run.GrooveSide = defaults.GrooveSide
    end
    Run.StartEnd = registry:GetString(SettingsKey("StartEnd"), defaults.StartEnd)
    if Run.StartEnd ~= "None" and Run.StartEnd ~= "Finger" and Run.StartEnd ~= "Gap" then
        Run.StartEnd = defaults.StartEnd
    end
    Run.EndEnd = registry:GetString(SettingsKey("EndEnd"), defaults.EndEnd)
    if Run.EndEnd ~= "None" and Run.EndEnd ~= "Finger" and Run.EndEnd ~= "Gap" then
        Run.EndEnd = defaults.EndEnd
    end
    Run.CloseLoop = registry:GetBool(SettingsKey("CloseLoop"), defaults.CloseLoop)
    Milling.FingerAllowance = registry:GetDouble(SettingsKey("FingerAllowance"), defaults.FingerAllowance)
    Milling.GrooveAllowance = registry:GetDouble(SettingsKey("GrooveAllowance"), defaults.GrooveAllowance)
    Milling.ProfileFinishAllowance = registry:GetDouble(SettingsKey("ProfileFinishAllowance"), defaults.ProfileFinishAllowance)
    Milling.PartGap = registry:GetDouble(SettingsKey("PartGap"), defaults.PartGap)
    Milling.ProfileTabs = registry:GetBool(SettingsKey("ProfileTabs"), defaults.ProfileTabs)
    Milling.ProfileFinish = registry:GetBool(SettingsKey("ProfileFinish"), defaults.ProfileFinish)
    ToolsRead()
end
-- =====================================================]]
function SettingsWrite()
    local registry = Registry(Run.RegName)
    registry:SetInt("DialogWidth", Run.DialogWidth)
    registry:SetInt("DialogHeight", Run.DialogHeight)
    registry:SetDouble(SettingsKey("StockT"), Run.StockT)
    registry:SetDouble(SettingsKey("StockW"), Run.StockW)
    registry:SetBool(SettingsKey("FingerAuto"), Run.FingerAuto)
    registry:SetInt(SettingsKey("FingerCountManual"), Run.FingerCountManual)
    registry:SetString(SettingsKey("JointStyle"), Run.JointStyle)
    registry:SetDouble(SettingsKey("FingerClearance"), Run.FingerClearance)
    registry:SetBool(SettingsKey("GrooveOn"), Run.GrooveOn)
    registry:SetDouble(SettingsKey("GrooveInset"), Run.GrooveInset)
    registry:SetDouble(SettingsKey("BottomThickness"), Run.BottomThickness)
    registry:SetDouble(SettingsKey("GrooveClearance"), Run.GrooveClearance)
    registry:SetDouble(SettingsKey("GrooveDepth"), Run.GrooveDepth)
    registry:SetString(SettingsKey("Mode"), Run.Mode)
    registry:SetBool(SettingsKey("EEToward"), Run.EEToward)
    registry:SetString(SettingsKey("EEPhase"), Run.EEPhase)
    registry:SetDouble(SettingsKey("EBBackLength"), Run.EBBackLength)
    registry:SetDouble(SettingsKey("EBFirstStub"), Run.EBFirstStub)
    registry:SetDouble(SettingsKey("EBOpening"), Run.EBOpening)
    registry:SetString(SettingsKey("EBPhase"), Run.EBPhase)
    for i = 1, 4 do
        registry:SetDouble(SettingsKey("Piece" .. i .. "Length"), Run.Piece[i].Length)
    end
    for i = 2, 4 do
        registry:SetBool(SettingsKey("Piece" .. i .. "Enabled"), Run.Piece[i].Enabled)
    end
    registry:SetString(SettingsKey("GrooveSide"), Run.GrooveSide)
    registry:SetString(SettingsKey("StartEnd"), Run.StartEnd)
    registry:SetString(SettingsKey("EndEnd"), Run.EndEnd)
    registry:SetBool(SettingsKey("CloseLoop"), Run.CloseLoop)
    registry:SetDouble(SettingsKey("FingerAllowance"), Milling.FingerAllowance)
    registry:SetDouble(SettingsKey("GrooveAllowance"), Milling.GrooveAllowance)
    registry:SetDouble(SettingsKey("ProfileFinishAllowance"), Milling.ProfileFinishAllowance)
    registry:SetDouble(SettingsKey("PartGap"), Milling.PartGap)
    registry:SetBool(SettingsKey("ProfileTabs"), Milling.ProfileTabs)
    registry:SetBool(SettingsKey("ProfileFinish"), Milling.ProfileFinish)
    ToolsWrite()
end
-- =============== End of File =========================]]
