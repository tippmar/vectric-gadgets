-- Small geometry helpers, the finger-end pocketing routine, and the Test cut mode driver. Copied and
-- generalized from BlumDrawerMaker/BlumDrawerTools.xlua and BlumDrawerMaker/BlumDrawerJoinery.xlua; see the
-- per-function comments below for what changed and why.
function IdKey(raw_id) -- String form of a UUID, usable as a table key
    return luaUUID(raw_id):AsString()
end
-- =====================================================]]
function GetDistance(objA, objB) -- Get the length for each of the components x and y
    local xDist = objB.x - objA.x
    local yDist = objB.y - objA.y
    return math.sqrt((xDist ^ 2) + (yDist ^ 2))
end
-- =====================================================]]
function FormatThickness(thickness) -- 0.5000 -> "0.5"
    local text = string.format("%.4f", thickness):gsub("0+$", ""):gsub("%.$", "")
    return text
end
-- =====================================================]]
function ThicknessTag(thickness) -- Suffix that keeps layers / toolpaths of different thicknesses apart
    return " (" .. FormatThickness(thickness) .. ")"
end
-- =====================================================]]
function Polar2D(pt, ang, dis) -- Point at distance dis from pt, at angle ang (degrees). Not a Vectric API.
    return Point2D((pt.X + dis * math.cos(math.rad(ang))), (pt.Y + dis * math.sin(math.rad(ang))))
end
-- =====================================================]]
function PointAlong(pa, pb, fraction)
    -- Point a given fraction of the way from pa to pb
    return Point2D(pa.x + ((pb.x - pa.x) * fraction), pa.y + ((pb.y - pa.y) * fraction))
end
-- =====================================================]]
function TabCountForEdge(edge_length)
    -- One tab per foot of edge, never fewer than two. A single tab lets the part pivot around it, so two on
    -- each of the two clean edges is the least that holds a part square while the profile pass cuts it free.
    -- More than that is only extra nubs to pare off by hand afterward.
    local spacing = Run.InMM and 304.8 or 12.0
    local count = math.floor((edge_length / spacing) + 0.5) -- Lua 5.1 has no math.round
    if count < 2 then
        count = 2
    end
    return count
end
-- =====================================================]]
function AddProfileTabs(cad_contour, pt1, pt2, pt3, pt4)
    -- Holds a part in the sheet while its profile pass cuts it free. Tabs go only on the two edges that run the
    -- length of the part (pt1->pt2 and pt3->pt4). The other two, pt2->pt3 and pt4->pt1, carry the finger joints,
    -- and a tab left on a mating surface would have to be pared off before the joint would close.
    if (not Milling.ProfileTabs) or (cad_contour == nil) then
        return false
    end
    local count = TabCountForEdge(GetDistance(pt1, pt2))
    for i = 1, count do
        local fraction = (i - 0.5) / count -- evenly spaced along the edge, and never on a corner
        cad_contour:InsertToolpathTabAtPoint(PointAlong(pt1, pt2, fraction))
        cad_contour:InsertToolpathTabAtPoint(PointAlong(pt4, pt3, fraction))
    end
    return true
end
-- =====================================================]]
function DrawBox(p1, p2, p3, p4, Layer)
    --[[ Draw Box
function main(script_path)
local MyPt1 = Point2D(1.0,1.0)
local MyPt2 = Point2D(1.0,3.0)
local MyPt3 = Point2D(3.0,1.0)
local MyPt4 = Point2D(3.0,3.0)
local layer = "My Box"
DrawBox(MyPt1 ,MyPt2, MyPt3, MyPt4, Layer)
return true
end -- function end
-- -----------------------------------------------------]]
    local job = VectricJob()
    if not job.Exists then
        DisplayMessageBox("Error in DrawBox: No job loaded")
        return false;
    end -- if end
    local line = Contour(0.0)
    local layer = job.LayerManager:GetLayerWithName(Layer)
    line:AppendPoint(p1);
    line:LineTo(p2);
    line:LineTo(p3);
    line:LineTo(p4);
    line:LineTo(p1);
    local cad_contour = CreateCadContour(line)
    layer:AddObject(cad_contour, true)
    job:Refresh2DView()
    -- Returned so a caller that needs to attach toolpath tabs has the contour. Callers that ignore it are
    -- unaffected: a CadContour is as truthy as the "true" this used to return.
    return cad_contour
end -- function end
-- =====================================================]]
function OccupiedMaxX() -- Right-most X of all vectors on the active sheet, or nil if the sheet is empty
    local selection = Milling.job.Selection
    selection:Clear()
    Milling.job:SelectAllVectors()
    local max_x = nil
    if not selection.IsEmpty then
        max_x = selection:GetBoundingBox().TRC.x
    end
    selection:Clear()
    return max_x
end
-- =====================================================]]
function OpenSpaceStart() -- Start point for new parts, right of anything already drawn on the active sheet
    local start_x = 1.0 * Run.Cal
    local max_x = OccupiedMaxX()
    if max_x ~= nil then
        start_x = math.max(start_x, max_x + Milling.PartGap + 1.0 * Run.Cal)
    end
    return Point2D(start_x, 1.0 * Run.Cal)
end
-- =====================================================]]
function ActivateThicknessSheet(thickness) -- Finds or creates the sheet for this material thickness
    local sheet_manager = Milling.job.SheetManager
    local sheet_name = FormatThickness(thickness) .. " Material"
    for id in sheet_manager:GetSheetIds() do
        if sheet_manager:GetSheetName(id) == sheet_name then
            sheet_manager.ActiveSheetId = id
            Milling.job:Refresh2DView()
            return
        end
    end
    local sheet_id
    if sheet_manager.NumberOfSheets == 1 and OccupiedMaxX() == nil then
        -- First run in a fresh job: adopt the empty default sheet rather than leaving it unused
        sheet_id = sheet_manager.ActiveSheetId
        sheet_manager:RenameSheet(sheet_id, sheet_name)
    else
        sheet_id = sheet_manager:CreateNewSheet(sheet_name)
    end
    sheet_manager:ResizeSheet(sheet_id, MaterialBlock().Width, MaterialBlock().Height, thickness, false)
    sheet_manager.ActiveSheetId = sheet_id
    Milling.job:Refresh2DView()
end
