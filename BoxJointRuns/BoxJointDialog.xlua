-- VECTRIC LUA SCRIPT
-- =====================================================]]
function BuildDialog()
    -- Look and feel copied from Blum Drawer Maker's DialogWindow.Style (BlumDrawerDialog.xlua:18-258), trimmed to
    -- the classes this dialog uses, and inlined because a DialogWindow global table is not allowed here.
    local html = [[<!DOCTYPE html><html><head><title>Box Joint Runs</title>
<style>
html { overflow: hidden }
body { background-color: #3a4660; overflow: hidden; font-family: arial, helvetica, sans-serif; font-size: 12px;
    color: #FFFFFF; }
table { width: 100%; border: 0; }
.FormButton { font-weight: bold; width: 75px; font-size: 12px; white-space: nowrap; background-color: #630;
    color: #FFFFFF; }
.LuaButton { font-weight: bold; font-size: 12px; background-color: #663300; color: #FFFFFF; }
.ToolNameLabel { font-weight: bolder; font-size: 12px; text-align: left; color: #000; width: 70%; }
.ToolPicker { font-weight: bold; text-align: center; font-size: 12px; width: 50px; background-color: #663300;
    color: #FFFFFF; }
.h1-l { font-size: 12px; font-weight: bold; text-align: left; white-space: nowrap; }
.h1-r { font-size: 12px; font-weight: bold; text-align: right; white-space: nowrap; }
.h1-rP { font-size: 12px; font-weight: bold; text-align: right; white-space: nowrap; padding-right: 4px;
    padding-left: 4px; }
.h2-c { font-size: 14px; font-weight: bold; text-align: center; white-space: nowrap; text-shadow: 2px 2px white; }
#InquiryHelpMain { width: 80px; }
</style></head><body>
<table>
  <tr>
    <td colspan="2" class="h2-c">Stock</td>
    <td colspan="2" class="h2-c">Fingers</td>
  </tr>
  <tr>
    <td class="h1-rP"><label title="Thickness of every piece in this run.">Thickness (T)</label></td>
    <td class="h1-l"><input type="text" class="h1-l" id="Run.StockT" size="10" maxlength="10"/></td>
    <td class="h1-rP"><label title="Uncheck to enter a finger count by hand.">Automatic Count</label></td>
    <td class="h1-l"><input type="checkbox" class="LuaButton" id="FingerAutoCheck"/></td>
  </tr>
  <tr>
    <td class="h1-rP"><label title="The dimension the fingers run across -- a drawer's height.">Width (W)</label></td>
    <td class="h1-l"><input type="text" class="h1-l" id="Run.StockW" size="10" maxlength="10"/></td>
    <td class="h1-rP"><label title="Used only when Automatic Count is unchecked.">Manual Count</label></td>
    <td class="h1-l"><input type="text" class="h1-l" id="Run.FingerCountManual" size="10" maxlength="10"/></td>
  </tr>
  <tr>
    <td class="h1-rP"><label title="What this run draws and machines.">Mode</label></td>
    <td class="h1-l">
      <select id="Run.Mode" size="1">
        <option>Test Cut</option>
        <option>Chain</option>
        <option>Existing End</option>
      </select>
    </td>
    <td class="h1-rP"><label title="Blind styles are excluded: any piece can be flipped face for face.">Joint Style</label></td>
    <td class="h1-l">
      <select id="Run.JointStyle" size="1">
        <option>Through</option>
        <option>Dog Bone</option>
        <option>T-Bone</option>
      </select>
    </td>
  </tr>
  <tr>
    <td colspan="2">&nbsp;</td>
    <td class="h1-rP"><label title="Gap opened beyond the finger's nominal width, split between both sides.">Finger Clearance</label></td>
    <td class="h1-l"><input type="text" class="h1-l" id="Run.FingerClearance" size="10" maxlength="10"/></td>
  </tr>
  <tr>
    <td colspan="4" class="h2-c">Chain</td>
  </tr>
  <tr>
    <td class="h1-rP"><label title="Piece 1 is always part of the chain.">Piece 1 Length</label></td>
    <td class="h1-l"><input type="checkbox" checked="checked" disabled="disabled" title="Piece 1 is always on."/> <input type="text" class="h1-l" id="Run.Piece1Length" size="10" maxlength="10"/></td>
    <td class="h1-rP">&nbsp;</td>
    <td class="h1-l">&nbsp;</td>
  </tr>
  <tr>
    <td class="h1-rP"><label title="Tick to add Piece 2 to the chain.">Piece 2 Length</label></td>
    <td class="h1-l"><input type="checkbox" class="LuaButton" id="Piece2Check"/> <input type="text" class="h1-l" id="Run.Piece2Length" size="10" maxlength="10"/></td>
    <td class="h1-rP">&nbsp;</td>
    <td class="h1-l">&nbsp;</td>
  </tr>
  <tr>
    <td class="h1-rP"><label title="Tick to add Piece 3 to the chain; needs Piece 2 on.">Piece 3 Length</label></td>
    <td class="h1-l"><input type="checkbox" class="LuaButton" id="Piece3Check"/> <input type="text" class="h1-l" id="Run.Piece3Length" size="10" maxlength="10"/></td>
    <td class="h1-rP">&nbsp;</td>
    <td class="h1-l">&nbsp;</td>
  </tr>
  <tr>
    <td class="h1-rP"><label title="Tick to add Piece 4 to the chain; needs Piece 3 on.">Piece 4 Length</label></td>
    <td class="h1-l"><input type="checkbox" class="LuaButton" id="Piece4Check"/> <input type="text" class="h1-l" id="Run.Piece4Length" size="10" maxlength="10"/></td>
    <td class="h1-rP">&nbsp;</td>
    <td class="h1-l">&nbsp;</td>
  </tr>
  <tr>
    <td class="h1-rP"><label title="The end at the start of Piece 1. None = plain square end; Finger = Finger at bottom; Gap = Gap at bottom.">Start End</label></td>
    <td class="h1-l">
      <select id="Run.StartEnd" size="1">
        <option>None</option>
        <option>Finger</option>
        <option>Gap</option>
      </select>
    </td>
    <td class="h1-rP"><label title="The end at the end of the last enabled piece. None = plain square end; Finger = Finger at bottom; Gap = Gap at bottom.">Last End</label></td>
    <td class="h1-l">
      <select id="Run.EndEnd" size="1">
        <option>None</option>
        <option>Finger</option>
        <option>Gap</option>
      </select>
    </td>
  </tr>
  <tr>
    <td class="h1-rP"><label title="Needs all 4 pieces on. Joins the end of Piece 4 to the start of Piece 1, and replaces both end dropdowns above.">Close Loop</label></td>
    <td class="h1-l"><input type="checkbox" class="LuaButton" id="CloseLoopCheck"/></td>
    <td class="h1-rP">&nbsp;</td>
    <td class="h1-l">&nbsp;</td>
  </tr>
  <tr>
    <td colspan="4" class="h2-c">Existing End</td>
  </tr>
  <tr>
    <td class="h1-rP"><label title="The end being cut is always at X = 0. Turn a right-hand stub end for end so nothing is drawn at negative X. Toward = bottom edge toward the operator (on Y = 0); Away = bottom edge away from the operator (on Y = Width).">Bottom Edge</label></td>
    <td class="h1-l">
      <select id="Run.EEToward" size="1">
        <option>Toward</option>
        <option>Away</option>
      </select>
    </td>
    <td class="h1-rP"><label title="Finger = Finger at bottom; Gap = Gap at bottom.">Phase</label></td>
    <td class="h1-l">
      <select id="Run.EEPhase" size="1">
        <option>Finger</option>
        <option>Gap</option>
      </select>
    </td>
  </tr>
  <tr>
    <td colspan="2" class="h2-c">Bottom Groove</td>
    <td colspan="2" class="h2-c">Cutting</td>
  </tr>
  <tr>
    <td class="h1-rP"><label title="Cut a groove for the drawer bottom.">Groove On</label></td>
    <td class="h1-l"><input type="checkbox" class="LuaButton" id="GrooveOnCheck"/></td>
    <td class="h1-rP"><label title="Minimum gap left between parts on the sheet.">Part Gap</label></td>
    <td class="h1-l"><input type="text" class="h1-l" id="Milling.PartGap" size="10" maxlength="10"/></td>
  </tr>
  <tr>
    <td class="h1-rP"><label title="From the bottom edge to the near side of the groove.">Inset</label></td>
    <td class="h1-l"><input type="text" class="h1-l" id="Run.GrooveInset" size="10" maxlength="10"/></td>
    <td class="h1-rP"><label title="Hold each part in the sheet while the profile cuts it free.">Tabs</label></td>
    <td class="h1-l"><input type="checkbox" class="LuaButton" id="ProfileTabsCheck"/></td>
  </tr>
  <tr>
    <td class="h1-rP"><label>Groove Width</label></td>
    <td class="h1-l"><input type="text" class="h1-l" id="Run.GrooveWidth" size="10" maxlength="10"/></td>
    <td class="h1-rP"><label title="Roughs to this allowance, then a full-depth finishing pass takes it off.">Profile Finishing Pass</label></td>
    <td class="h1-l"><input type="checkbox" class="LuaButton" id="ProfileFinishCheck"/></td>
  </tr>
  <tr>
    <td class="h1-rP"><label>Groove Depth</label></td>
    <td class="h1-l"><input type="text" class="h1-l" id="Run.GrooveDepth" size="10" maxlength="10"/></td>
    <td class="h1-rP"><label>Finish Allowance</label></td>
    <td class="h1-l"><input type="text" class="h1-l" id="Milling.ProfileFinishAllowance" size="10" maxlength="10"/></td>
  </tr>
  <tr>
    <td class="h1-rP"><label title="Which way the grooves face once the pieces are folded together. Outside adds a groove-sized pocket through each finger at the bottom so the mating groove runs to the corner. Joints between pieces only; Start/End ends and the Existing modes never get it.">Groove Faces</label></td>
    <td class="h1-l">
      <select id="Run.GrooveSide" size="1">
        <option>Inside</option>
        <option>Outside</option>
      </select>
    </td>
    <td class="h1-rP">&nbsp;</td>
    <td class="h1-l">&nbsp;</td>
  </tr>
</table>
<table>
  <tr>
    <td colspan="5"><hr></td>
  </tr>
  <tr>
    <td class="h1-rP"><label title="Bit for profile milling">Profile Bit:</label></td>
    <td bgcolor="#33FFFF" class="ToolNameLabel"><span id="ToolNameProfile">-</span></td>
    <td class="h1-l"><input id="ToolChooseProfile" class="ToolPicker" type="button" value="Tool"/></td>
    <td colspan="2">&nbsp;</td>
  </tr>
  <tr>
    <td class="h1-rP"><label title="Bit for finger joint detail milling">Finger Bit:</label></td>
    <td bgcolor="#00FFCC" class="ToolNameLabel"><span id="ToolNameFinger">-</span></td>
    <td class="h1-l"><input id="ToolChooseFinger" class="ToolPicker" type="button" value="Tool"/></td>
    <td class="h1-rP"><label>Allowance</label></td>
    <td class="h1-l"><input type="text" class="h1-l" id="Milling.FingerAllowance" size="8" maxlength="10"/></td>
  </tr>
  <tr>
    <td class="h1-rP"><label title="Bit for finger joint material clearing">Finger Clearing Bit:</label></td>
    <td bgcolor="#00FFCC" class="ToolNameLabel"><span id="ToolNameFingerClear">-</span></td>
    <td class="h1-l"><input id="ToolChooseFingerClear" class="ToolPicker" type="button" value="Tool"/></td>
  </tr>
  <tr>
    <td class="h1-rP"><label title="Bit for the bottom groove">Dado Bit:</label></td>
    <td bgcolor="#FFFF33" class="ToolNameLabel"><span id="ToolNameDado">-</span></td>
    <td class="h1-l"><input id="ToolChooseDado" class="ToolPicker" type="button" value="Tool"/></td>
    <td class="h1-rP"><label>Allowance</label></td>
    <td class="h1-l"><input type="text" class="h1-l" id="Milling.GrooveAllowance" size="8" maxlength="10"/></td>
  </tr>
</table>
<table>
  <tr>
    <td colspan="3"><hr></td>
  </tr>
  <tr>
    <td class="h1-l"><input id="InquiryHelpMain" class="LuaButton" type="button" value="Help"/></td>
    <td class="alert" id="GadgetName.Alert"></td>
    <td class="h1-r"><input id="ButtonOK" class="FormButton" type="button" value="Run"/>
                     <input id="ButtonCancel" class="FormButton" type="button" value="Cancel"/></td>
  </tr>
</table>
</body></html>]]
    Run.dialog = HTML_Dialog(true, html, Run.DialogWidth, Run.DialogHeight, "Box Joint Runs " .. Run.UnitLabel)
    Run.dialog:AddDoubleField("Run.StockT", Run.StockT)
    Run.dialog:AddDoubleField("Run.StockW", Run.StockW)
    Run.dialog:AddCheckBox("FingerAutoCheck", Run.FingerAuto)
    Run.dialog:AddIntegerField("Run.FingerCountManual", Run.FingerCountManual)
    Run.dialog:AddDropDownList("Run.JointStyle", Run.JointStyle)
    Run.dialog:AddDoubleField("Run.FingerClearance", Run.FingerClearance)
    Run.dialog:AddCheckBox("GrooveOnCheck", Run.GrooveOn)
    Run.dialog:AddDoubleField("Run.GrooveInset", Run.GrooveInset)
    Run.dialog:AddDoubleField("Run.GrooveWidth", Run.GrooveWidth)
    Run.dialog:AddDoubleField("Run.GrooveDepth", Run.GrooveDepth)
    Run.dialog:AddDoubleField("Milling.FingerAllowance", Milling.FingerAllowance)
    Run.dialog:AddDoubleField("Milling.GrooveAllowance", Milling.GrooveAllowance)
    Run.dialog:AddDoubleField("Milling.PartGap", Milling.PartGap)
    Run.dialog:AddCheckBox("ProfileTabsCheck", Milling.ProfileTabs)
    Run.dialog:AddCheckBox("ProfileFinishCheck", Milling.ProfileFinish)
    Run.dialog:AddDoubleField("Milling.ProfileFinishAllowance", Milling.ProfileFinishAllowance)
    Run.dialog:AddDropDownList("Run.Mode", Run.Mode)
    Run.dialog:AddDropDownList("Run.EEToward", Run.EEToward and "Toward" or "Away")
    Run.dialog:AddDropDownList("Run.EEPhase", Run.EEPhase)
    for i = 1, 4 do
        Run.dialog:AddDoubleField("Run.Piece" .. i .. "Length", Run.Piece[i].Length)
    end
    for i = 2, 4 do
        Run.dialog:AddCheckBox("Piece" .. i .. "Check", Run.Piece[i].Enabled)
    end
    Run.dialog:AddDropDownList("Run.GrooveSide", Run.GrooveSide)
    Run.dialog:AddDropDownList("Run.StartEnd", Run.StartEnd)
    Run.dialog:AddDropDownList("Run.EndEnd", Run.EndEnd)
    Run.dialog:AddCheckBox("CloseLoopCheck", Run.CloseLoop)
    Run.dialog:AddLabelField("ToolNameProfile", Milling.ProfileTool and Milling.ProfileTool.Name or "-")
    Run.dialog:AddToolPicker("ToolChooseProfile", "ToolNameProfile", ToolDBId())
    Run.dialog:AddToolPickerValidToolType("ToolChooseProfile", Tool.END_MILL)
    Run.dialog:AddLabelField("ToolNameFinger", Milling.FingerTool and Milling.FingerTool.Name or "-")
    Run.dialog:AddToolPicker("ToolChooseFinger", "ToolNameFinger", ToolDBId())
    Run.dialog:AddToolPickerValidToolType("ToolChooseFinger", Tool.END_MILL)
    Run.dialog:AddLabelField("ToolNameFingerClear", Milling.FingerClearTool and Milling.FingerClearTool.Name or "-")
    Run.dialog:AddToolPicker("ToolChooseFingerClear", "ToolNameFingerClear", ToolDBId())
    Run.dialog:AddToolPickerValidToolType("ToolChooseFingerClear", Tool.END_MILL)
    Run.dialog:AddLabelField("ToolNameDado", Milling.DadoTool and Milling.DadoTool.Name or "-")
    Run.dialog:AddToolPicker("ToolChooseDado", "ToolNameDado", ToolDBId())
    Run.dialog:AddToolPickerValidToolType("ToolChooseDado", Tool.END_MILL)
end
-- =====================================================]]
function ShowSettingsDialog()
    BuildDialog()
    if not Run.dialog:ShowDialog() then
        return false
    end
    -- Window size is unit-independent, so it is stored outside the Imperial/Metric settings keys.
    Run.DialogWidth = Run.dialog.WindowWidth
    Run.DialogHeight = Run.dialog.WindowHeight
    Run.StockT = math.abs(Run.dialog:GetDoubleField("Run.StockT"))
    Run.StockW = math.abs(Run.dialog:GetDoubleField("Run.StockW"))
    Run.FingerAuto = Run.dialog:GetCheckBox("FingerAutoCheck")
    Run.FingerCountManual = Run.dialog:GetIntegerField("Run.FingerCountManual")
    Run.JointStyle = Run.dialog:GetDropDownListValue("Run.JointStyle")
    Run.FingerClearance = math.abs(Run.dialog:GetDoubleField("Run.FingerClearance"))
    Run.GrooveOn = Run.dialog:GetCheckBox("GrooveOnCheck")
    Run.GrooveInset = math.abs(Run.dialog:GetDoubleField("Run.GrooveInset"))
    Run.GrooveWidth = math.abs(Run.dialog:GetDoubleField("Run.GrooveWidth"))
    Run.GrooveDepth = math.abs(Run.dialog:GetDoubleField("Run.GrooveDepth"))
    Run.Mode = Run.dialog:GetDropDownListValue("Run.Mode")
    Run.EEToward = (Run.dialog:GetDropDownListValue("Run.EEToward") ~= "Away")
    Run.EEPhase = Run.dialog:GetDropDownListValue("Run.EEPhase")
    for i = 1, 4 do
        Run.Piece[i].Length = math.abs(Run.dialog:GetDoubleField("Run.Piece" .. i .. "Length"))
    end
    -- A later piece can be on only while the one before it is; it silently drops back to off otherwise.
    Run.Piece[2].Enabled = Run.dialog:GetCheckBox("Piece2Check")
    Run.Piece[3].Enabled = Run.dialog:GetCheckBox("Piece3Check") and Run.Piece[2].Enabled
    Run.Piece[4].Enabled = Run.dialog:GetCheckBox("Piece4Check") and Run.Piece[3].Enabled
    Run.GrooveSide = Run.dialog:GetDropDownListValue("Run.GrooveSide")
    Run.StartEnd = Run.dialog:GetDropDownListValue("Run.StartEnd")
    Run.EndEnd = Run.dialog:GetDropDownListValue("Run.EndEnd")
    Run.CloseLoop = Run.dialog:GetCheckBox("CloseLoopCheck") and Run.Piece[4].Enabled
    -- Allowances are signed, as Blum Drawer Maker's are: no math.abs here.
    Milling.FingerAllowance = Run.dialog:GetDoubleField("Milling.FingerAllowance")
    Milling.GrooveAllowance = Run.dialog:GetDoubleField("Milling.GrooveAllowance")
    Milling.PartGap = math.abs(Run.dialog:GetDoubleField("Milling.PartGap"))
    Milling.ProfileTabs = Run.dialog:GetCheckBox("ProfileTabsCheck")
    Milling.ProfileFinish = Run.dialog:GetCheckBox("ProfileFinishCheck")
    Milling.ProfileFinishAllowance = math.abs(Run.dialog:GetDoubleField("Milling.ProfileFinishAllowance"))
    if Run.dialog:GetTool("ToolChooseProfile") then
        Milling.ProfileTool = Run.dialog:GetTool("ToolChooseProfile")
    end
    if Run.dialog:GetTool("ToolChooseFinger") then
        Milling.FingerTool = Run.dialog:GetTool("ToolChooseFinger")
    end
    if Run.dialog:GetTool("ToolChooseFingerClear") then
        Milling.FingerClearTool = Run.dialog:GetTool("ToolChooseFingerClear")
    end
    if Run.dialog:GetTool("ToolChooseDado") then
        Milling.DadoTool = Run.dialog:GetTool("ToolChooseDado")
    end
    return true
end
-- =====================================================]]
-- Check box callbacks. The LuaButton class is what binds a check box to the dialog, and VCarve then calls
-- OnLuaButton_<id> on every click, so each check box needs one even though ticking it changes nothing until
-- Run is pressed (as BlumDrawerDialog.xlua's OnLuaButton_TestCutCheck). IDs therefore carry no dots.
function OnLuaButton_FingerAutoCheck()
    return true
end
function OnLuaButton_Piece2Check()
    return true
end
function OnLuaButton_Piece3Check()
    return true
end
function OnLuaButton_Piece4Check()
    return true
end
function OnLuaButton_CloseLoopCheck()
    return true
end
function OnLuaButton_GrooveOnCheck()
    return true
end
function OnLuaButton_ProfileTabsCheck()
    return true
end
function OnLuaButton_ProfileFinishCheck()
    return true
end
-- =============== End of File =========================]]
