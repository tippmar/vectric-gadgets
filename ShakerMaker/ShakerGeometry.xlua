    -- =========================================================================]]
    local function AddGroupToJob(job, group, layer_name)
        --  create a CadObject to represent the  group
        local cad_object = CreateCadGroup(group);
        -- create a layer with passed name if it doesnt already exist
        local layer = job.LayerManager:GetLayerWithName(layer_name)
        -- and add our object to it
        layer:AddObject(cad_object, true)
        return cad_object
    end -- end function
    -- =========================================================================]]
    local job = VectricJob()
    if not job.Exists then
        DisplayMessageBox("Error in AddGroupToJob: Not finding a job loaded")
        return false
    end
    local strlen = string.len(what)
    local strup = what
    local x = strlen
    local i = 1
    local y = ""
    local ptx = where
    group = ContourGroup(true)
    while i <= x do
        y = string.byte(string.sub(strup, i, i))
        if (y >= 97) and (y <= 122) then -- Lower case
            ptx = MonoFont(job, ptx, y, (size * 0.75), lay, ang)
            ptx = Polar2D(ptx, ang, size * 0.05)
        else -- Upper case
            ptx = MonoFont(job, ptx, y, size, lay, ang)
            ptx = Polar2D(ptx, ang, size * 0.07)
        end
        i = i + 1
    end -- while end;
    AddGroupToJob(job, group, lay)
    job:Refresh2DView()
    return true
end -- Draw Text function end
-- =====================================================]]
function ApplyLayerNames()
    -- Must run after the dialog, as Box Joint Runs' ApplyThicknessLayerNames does, so the tagged names are never
    -- written to the registry. A toolpath is reused (recalculated) by a later run with the same name, so anything
    -- that changes what it cuts -- the thickness or the recess depth -- goes into the layer and toolpath names.
    local depth = FormatThickness(Shaker.Depth)
    local tag = " (" .. FormatThickness(Shaker.Thickness) .. ", " .. depth .. ")"
    Milling.LNProfile = "SM Profile" .. ThicknessTag(Shaker.Thickness)
    Milling.LNLabels = "SM Labels" .. ThicknessTag(Shaker.Thickness)
    Milling.LNPocket = "SM Pocket" .. tag
    Milling.LNVCarve = "SM V-Carve" .. tag
    Milling.LNCorners = {}
    Milling.TPCorners = {}
    for i = 2, 3 do
        Milling.LNCorners[i] = "SM Corners " .. tostring(i - 1) .. tag
        Milling.TPCorners[i] = "SM Corners " .. tostring(i - 1) .. " " .. depth
    end
    Milling.TPProfile = "SM Profile"
    Milling.TPPocket = "SM Pocket " .. depth
    Milling.TPVCarve = "SM V-Carve " .. depth
end
-- =====================================================]]
function DrawCornerSquares(x1, y1, x2, y2, size, layer_name)
    -- One size x size square tucked into each corner of the floor rectangle (x1, y1)-(x2, y2).
    DrawRect(x1, y1, x1 + size, y1 + size, layer_name)
    DrawRect(x2 - size, y1, x2, y1 + size, layer_name)
    DrawRect(x2 - size, y2 - size, x2, y2, layer_name)
    DrawRect(x1, y2 - size, x1 + size, y2, layer_name)
end
-- =====================================================]]
function LabelPart(x, y, index)
    -- "Door 2 (15 x 20)", on the panel floor near its bottom-left corner. The height starts at 0.25 and shrinks so
    -- the text fits the floor width; DrawWriter's letters advance about 0.7 of the text height each.
    local margin = 0.25 * Shaker.Cal
    local text = Shaker.PartName
    if Shaker.Quantity > 1 then
        text = text .. " " .. tostring(index)
    end
    text = text .. " (" .. FormatThickness(Shaker.Width) .. " x " .. FormatThickness(Shaker.Height) .. ")"
    local size = math.min(0.25 * Shaker.Cal, (Shaker.FloorW - (2.0 * margin)) / (string.len(text) * 0.7))
    if size <= 0.0 then
        return false
    end
    DrawWriter(text, Point2D(x + margin, y + margin), size, Milling.LNLabels, 0.0)
    return true
end
-- =====================================================]]
function DrawDoors()
    -- Lays Shaker.Quantity parts out left to right, in open space right of anything already on the sheet. Each part
    -- gets its outline (profile layer), its panel (the pocket's floor for a straight edge, or the top of the bevel
    -- for a V-bit, which VCarve's V-carving works from), and a set of corner squares for each corner bit.
    local origin = OpenSpaceStart()
    local gap = Milling.PartGap
    if Shaker.CutOut then
        gap = gap + Milling.ProfileTool.ToolDia
    end
    for n = 1, Shaker.Quantity do
        local x0 = origin.X + ((n - 1) * (Shaker.Width + gap))
        local y0 = origin.Y
        -- Outline drawn so its first edge (p1->p2) and third edge (p4->p3) are the two long ones, for the tabs.
        local p1, p2, p3, p4
        if Shaker.Height >= Shaker.Width then
            p1, p2 = Point2D(x0, y0), Point2D(x0, y0 + Shaker.Height)
            p3, p4 = Point2D(x0 + Shaker.Width, y0 + Shaker.Height), Point2D(x0 + Shaker.Width, y0)
        else
            p1, p2 = Point2D(x0, y0), Point2D(x0 + Shaker.Width, y0)
            p3, p4 = Point2D(x0 + Shaker.Width, y0 + Shaker.Height), Point2D(x0, y0 + Shaker.Height)
        end
        local outline = DrawBox(p1, p2, p3, p4, Milling.LNProfile)
        if Shaker.CutOut then
            AddProfileTabs(outline, p1, p2, p3, p4)
        end
        -- One panel, or two with a middle stile. The top of a panel's bevel is its floor grown by the bevel width
        -- on every side (zero for a straight edge).
        local fx1, fx2 = x0 + Shaker.FloorStile, x0 + Shaker.Width - Shaker.FloorStile
        for _, floor_y in ipairs(Shaker.PanelFloorY) do
            local fy1 = y0 + floor_y
            local fy2 = fy1 + Shaker.FloorH
            if Shaker.Edge == "V-Bit" then
                DrawRect(fx1 - Shaker.Bevel, fy1 - Shaker.Bevel, fx2 + Shaker.Bevel, fy2 + Shaker.Bevel, Milling.LNVCarve)
            else
                DrawRect(fx1, fy1, fx2, fy2, Milling.LNPocket)
            end
            for i, size in pairs(Shaker.CornerSize) do
                DrawCornerSquares(fx1, fy1, fx2, fy2, size, Milling.LNCorners[i])
            end
        end
        LabelPart(fx1, y0 + Shaker.PanelFloorY[1], n)
    end
    Milling.job:Refresh2DView()
    return true
end
-- =============== End of File =========================]]
